# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repo.

# Django
DJANGO_SETTINGS_MODULE=agora.settings.dev
DJANGO_SECRET_KEY=cambia-esto-en-cada-entorno
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,agora.aspaniasburgos.com

# Base de datos PostgreSQL
DATABASE_URL=postgres://agora:agora_local@db:5432/agora

# SSO Microsoft 365 (Entra ID)
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_TENANT_ID=
M365_REDIRECT_URI=http://localhost:8000/accounts/microsoft/login/callback/

# Almacenamiento Azure Blob (documentos)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=agora-documentos

# Email (vía MS Graph en producción)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Bitácora — retención (días)
BITACORA_RETENCION_DIAS=730

# Cifrado a nivel campo (Fernet) — Fase 2.5.1
# Generar nueva clave: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANTE: nunca regenerar esta clave sin re-cifrar los datos existentes.
AGORA_FIELD_ENCRYPTION_KEY=

# Política de seguridad
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
